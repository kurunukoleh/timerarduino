void cellChoose(bool ce1 , bool ce2 , bool ce3 , bool ce4){
    digitalWrite(2 , ce1);
    digitalWrite(3 , ce2);
    digitalWrite(4 , ce3);
    digitalWrite(5 , ce4);
  }

void render( int xa){

  byte smbl;

  if(xa < 1){ smbl = 0b11111100;}
   else if (xa >= 1 and xa < 2){ smbl = 0b00001100;}
   else if (xa >= 2 and xa < 3){ smbl = 0b11011010;}
   else if (xa >= 3 and xa < 4){ smbl = 0b11110010;}
   else if (xa >= 4 and xa < 5){ smbl = 0b01100110;}
   else if (xa >= 5 and xa < 6){ smbl = 0b10110110;}
   else if (xa >= 6 and xa < 7){ smbl = 0b10111110;}
   else if (xa >= 7 and xa < 8){ smbl = 0b11100000;}
   else if (xa >= 8 and xa< 9){ smbl =  0b11111110;}
   else{ smbl = 0b11110110 ;}

   shiftOut(12  , 11  , LSBFIRST  , smbl);
}

void nigger (int xb , bool cel1 , bool cel2 , bool  cel3 , bool cel4){

   digitalWrite(10 , LOW);
   render(xb);
   cellChoose(cel1 , cel2 , cel3 , cel4);
   digitalWrite(10 , HIGH);
  
  }

void paint( int t , int c1 , int c2 , int c3 , int c4){
    delay(t);
    nigger(c1 , 0 , 1 ,1 ,1);
    delay(t);
    nigger(c2 , 1 , 0 ,1 ,1);
    delay(t);
    nigger(c3 , 1 , 1 ,0 ,1);
    delay(t);
    nigger(c4 , 1 , 1 ,1 ,0);
  }


